<h1>방명록 목록</h1>
<a href="/guestbook/write">글쓰기</a>
<hr>
<table border="1">
    <tr>
        <th>작성자</th>
        <th>내용</th>
        <th>작성일</th>
        <th>관리</th>
    </tr>
    {{#list}}
    <tr>
        <td>{{author}}</td>
        <td>{{content}}</td>
        <td>{{createdAt}}</td>
        <td>
            <form action="/guestbook/{{id}}/delete" method="post">
                <button type="submit">삭제</button>
            </form>
        </td>
    </tr>
    {{/list}}
</table>
</table>